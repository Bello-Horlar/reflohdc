/* TITLE: manifest.json */
{
  "id": "/",
  "name": "REFLO - Customer Recovery & Booking",
  "short_name": "REFLO",
  "description": "Collect instant customer reviews, intercept negative feedback privately, and automate appointment bookings.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity"],
"icons": [
    {
      "src": "/assets/images/Reflo-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/Reflo-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/Reflo-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View business metrics & incoming alerts",
      "url": "/app/dashboard.html",
      "icons": [{ "src": "/assets/images/Reflo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "QR Hub",
      "short_name": "QR Hub",
      "description": "Access and share your universal QR code",
      "url": "/app/share.html",
      "icons": [{ "src": "/assets/images/Reflo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Bookings",
      "short_name": "Bookings",
      "description": "Manage customer appointments",
      "url": "/app/bookings.html",
      "icons": [{ "src": "/assets/images/Reflo-icon.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/images/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "REFLO Mobile Dashboard"
    },
    {
      "src": "/assets/images/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "REFLO Desktop Dashboard"
    }
  ]
}